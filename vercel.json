{
   "version": 2,
   "builds": [
      {
         "src": "app.js",
         "use": "@vercel/node",
         "config": {
            "includeFiles": [
               "views/**",
               "htdocs/**"
            ]
         }
      }
   ],
   "routes": [
      {
         "src": "/(.*)",
         "dest": "app.js"
      }
   ]
}